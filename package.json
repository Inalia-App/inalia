{
  "name": "inalia",
  "version": "0.1.0",
  "private": false,
  "description": "The Inalia CLI to use and set up slidev-addon-inalia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Inalia-App/inalia.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "bin": {
    "inalia": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
